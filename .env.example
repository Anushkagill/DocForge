# ==============================================================================
# DocForge Environment Configuration Template
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to version control.
# ==============================================================================

# Core environment: development | staging | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=DocForge

# Database (Neon PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/docforge?sslmode=require

# Security & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY=replace-with-a-secure-random-secret-key-for-jwt-signing
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Task Queue Broker (Render Key Value / Valkey connection string)
REDIS_URL=rediss://default:password@sample.valkey.render.com:6379

# AI Provider (Google Gemini API Key from Google AI Studio)
GEMINI_API_KEY=AIzaSySampleKeyDoNotCommitRealSecrets
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_GENERATION_MODEL=gemini-2.0-flash

# Object Storage (Cloudflare R2 or Neon Object Storage)
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
OBJECT_STORAGE_BUCKET=docforge-documents
OBJECT_STORAGE_ACCESS_KEY=sample_r2_access_key
OBJECT_STORAGE_SECRET_KEY=sample_r2_secret_key
OBJECT_STORAGE_REGION=auto

